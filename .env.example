DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Firebase
FIREBASE_PROJECT_ID=finance-98314

# Local dev: point at the Firebase Local Emulator Suite (run `firebase emulators:start`).
# Leave both blank to connect to the real project instead (requires
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH below to be set).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production only: path to a service-account JSON key (Console > Project
# Settings > Service Accounts). Not needed for emulator-based dev.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Client-safe config for the Firebase JS SDK (Console > Project Settings >
# General > Your apps > Web app, or `firebase apps:sdkconfig WEB <appId>`).
# Placeholders below are fine for emulator-only development.
FIREBASE_WEB_API_KEY=demo-api-key
FIREBASE_WEB_AUTH_DOMAIN=finance-98314.firebaseapp.com
FIREBASE_WEB_APP_ID=demo-app-id
